    def AttachAudioStreamProcessor(
        self, stream: AudioStream, processor: UInt
    ) raises:
        """Attach audio stream processor to stream, receives frames x 2 samples as 'float' (stereo)
        """
        self.handle.get_function[NoneType]("AttachAudioStreamProcessor")(
            stream, processor
        )

    def DetachAudioStreamProcessor(
        self, stream: AudioStream, processor: UInt
    ) raises:
        """Detach audio stream processor from stream"""
        self.handle.get_function[NoneType]("DetachAudioStreamProcessor")(
            stream, processor
        )

    def AttachAudioMixedProcessor(self, processor: UInt) raises:
        """Attach audio stream processor to the entire audio pipeline, receives frames x 2 samples as 'float' (stereo)
        """
        self.handle.get_function[NoneType]("AttachAudioMixedProcessor")(
            processor
        )

    def DetachAudioMixedProcessor(self, processor: UInt) raises:
